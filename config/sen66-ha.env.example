# Adresse IP locale (ou nom DNS) de la machine qui héberge Mosquitto
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=sen66
MQTT_PASSWORD=change-me

# Les valeurs ci-dessous peuvent rester telles quelles
MQTT_TOPIC_PREFIX=sen66/bureau
MQTT_DISCOVERY_PREFIX=homeassistant
DEVICE_NAME=Qualité de l’air — Bureau
DEVICE_SLUG=sen66_bureau
PUBLISH_INTERVAL=30
I2C_PORT=/dev/i2c-1
LOG_LEVEL=INFO
